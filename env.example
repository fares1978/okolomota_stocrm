# ---- STOCRM (was hard-coded in the n8n "Map Ticket Fields1" node) ----
STOCRM_HOST=okolomota.stocrm.ru
STOCRM_SID=replace-with-your-stocrm-sid
STOCRM_BOARD_ID=1277
STOCRM_SOURCE_ID=4
STOCRM_TIMEOUT=30

# ---- OpenRouter (was the "OpenRouter Nalog.Taxi" credential) ----
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT=120
LLM_MAX_ATTEMPTS=3
LLM_RETRY_DELAY=2

# ---- Optional webhook signature check. Leave empty to disable. ----
# SHARED_SECRET=

# ---- Behaviour ----
# false = match n8n exactly (phone comes only from the model).
PHONE_FALLBACK_TO_CALLER_ID=false
DRY_RUN=false
LOG_LEVEL=INFO
